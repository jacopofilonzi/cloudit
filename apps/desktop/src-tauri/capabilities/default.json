{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the app's own commands and event listening only (dialogs and the browser are opened by the backend).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-session",
    "allow-suggest-device-name",
    "allow-normalize-server-url",
    "allow-start-login",
    "allow-reopen-login-browser",
    "allow-cancel-login",
    "allow-sign-out",
    "allow-folders",
    "allow-refresh-status",
    "allow-refresh-all",
    "allow-sync-folder",
    "allow-sync-all",
    "allow-keep-local",
    "allow-keep-server",
    "allow-decide-later",
    "allow-cancel-op",
    "allow-scopes",
    "allow-server-folders",
    "allow-create-scope",
    "allow-pick-folder",
    "allow-link-folder",
    "allow-create-and-link",
    "allow-unlink",
    "allow-relocate",
    "allow-set-ignore",
    "allow-set-paused",
    "allow-refresh-names",
    "allow-activity",
    "allow-open-folder",
    "allow-open-history",
    "allow-open-log-dir",
    "allow-server-version",
    "allow-set-ui-language",
    "allow-app-settings",
    "allow-set-app-settings",
    "allow-pause-for",
    "allow-resume",
    "allow-set-auto-sync",
    "allow-running-processes",
    "allow-auto-states"
  ]
}
