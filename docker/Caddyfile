# Load balancer for docker-compose.ha.yml: round-robin over the cloudit replicas,
# taking a replica out of rotation while its /ready check fails.
{
	admin off
}

:8080 {
	reverse_proxy cloudit-1:8080 cloudit-2:8080 {
		lb_policy round_robin
		health_uri /ready
		health_interval 5s
		health_timeout 4s
		health_status 200
		# Retry another replica if one is down (only for requests that can be retried).
		lb_try_duration 5s
	}
}
