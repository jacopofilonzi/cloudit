# cloudit server configuration. Copy to `.env` and adjust; `.env` is git-ignored.
# Every variable is optional; the value shown is the default.

# Address and port the HTTP server listens on.
BIND_ADDR=0.0.0.0
PORT=8080

# Externally visible base URL, e.g. https://sync.example.com (no trailing slash).
# Not required yet; will be used for OAuth redirects and links.
# PUBLIC_URL=

# Directory for durable data (database, blobs when STORAGE=fs). In Docker: /data.
DATA_DIR=./data

# ---- Database ----------------------------------------------------------------
# sqlite:<path>?mode=rwc (single instance) or postgres://user:password@host:5432/db
# (required for more than one instance). Unset: SQLite at <DATA_DIR>/cloudit.db.
# Pending migrations run at startup; SQLite is first backed up to
# <DATA_DIR>/backups/cloudit-<timestamp>-pre-migrate.db (never pruned automatically).
# The URL may contain a password: it is never logged.
# DATABASE_URL=postgres://cloudit:change-me@postgres:5432/cloudit

# Connection pool size per instance. Default: 8 for SQLite, 10 for PostgreSQL.
# DB_MAX_CONNECTIONS=

# ---- Blob storage --------------------------------------------------------------
# `fs` (local directory) or `s3` (any S3-compatible service; required for more than
# one instance).
STORAGE=fs

# STORAGE=fs: directory for blobs. Default: <DATA_DIR>/blobs.
# STORAGE_FS_DIR=

# STORAGE=s3: endpoint as reached by the server; leave unset for AWS S3.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# Required with STORAGE=s3; the bucket must already exist.
# S3_BUCKET=cloudit
# Static credentials (set both, or neither to use the AWS environment/instance role).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Path-style URLs (endpoint/bucket/key). Needed by MinIO and Garage; false for
# virtual-hosted style (bucket.endpoint/key).
# S3_FORCE_PATH_STYLE=true

# Presigned URLs: clients upload/download blobs directly with S3 instead of through
# the server. Only enable it if clients can reach S3 (see S3_PUBLIC_ENDPOINT); leave it
# off when S3 is on a private network and the server proxies.
# S3_PRESIGN=false
# Endpoint as reached by clients, e.g. https://s3.example.com; presigned URLs are signed
# for this host (a proxy in front of it must keep the Host header). Default: S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
# Validity of presigned URLs: seconds or 30s/15m/1h/1d, at most 7d.
# S3_PRESIGN_TTL=15m

# ---- Redis (optional) ------------------------------------------------------------
# redis://[:password@]host:6379[/db] (Redis or Valkey; TLS rediss:// not supported yet).
# Shared rate limits across instances. Never required: if unset or down, the server
# falls back to per-instance limits and keeps serving.
# REDIS_URL=redis://valkey:6379

# Directory with the built web UI (apps/web/build), served as an SPA with an
# index.html fallback. If missing, the server logs a warning and serves only the API.
# In Docker: /app/web.
WEB_DIR=./apps/web/build

# Log verbosity: error, warn, info, debug, trace. RUST_LOG, if set, takes precedence
# and accepts full tracing filter directives (e.g. `info,cloudit_server=debug`).
LOG_LEVEL=info
# RUST_LOG=

# Log format: `pretty` (human-readable) or `json` (one object per line). Docker: json.
LOG_FORMAT=pretty

# Docker only (read by the container entrypoint, not by the server): numeric user and
# group the server runs as. The entrypoint starts as root, chowns DATA_DIR to them and
# drops privileges. Set them to your host user (`id -u` / `id -g`) to own ./data yourself.
# PUID=10001
# PGID=10001
