# cloudit server configuration. Copy to `.env` and adjust; `.env` is git-ignored.
# Every variable is optional and commented out; the value shown is the default outside
# Docker. Uncomment only what you change: the Docker image sets its own DATA_DIR,
# WEB_DIR and LOG_FORMAT, and an uncommented line here would override them.

# Address and port the HTTP server listens on.
# BIND_ADDR=0.0.0.0
# PORT=8080

# Externally visible base URL, e.g. https://sync.example.com (no trailing slash).
# Recommended in production: browser requests must come from this origin (CSRF check),
# session cookies get `Secure` when it is https, and `cloudit-server admin reset-password`
# prints full links. Unset: the origin is taken from the request's Host header.
# Sign-in providers build their callback URLs (<url>/api/v1/auth/oauth/<id>/callback) from
# it; without it they use the public URL stored at first-run setup or in the admin
# settings (this variable wins over the stored one).
# PUBLIC_URL=

# Set to true only when the server is reachable exclusively through a reverse proxy that
# sets X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host (Caddy, nginx, Traefik…).
# Then the client IP (rate limits) comes from X-Forwarded-For (rightmost non-private hop)
# and https / the origin from the other two. If clients can reach the server directly,
# leave it false: they could forge these headers.
# TRUST_PROXY_HEADERS=false

# ---- First-run setup -------------------------------------------------------------
# On first start (no accounts yet) the server logs a one-time setup token at WARN level;
# open the web UI and create the first admin with it, or print it again with
# `cloudit-server setup-token`. Set SETUP_TOKEN (at least 16 characters, secret) to choose
# it yourself, e.g. for automated deployments. Ignored once setup is completed.
# SETUP_TOKEN=

# ---- Secret key ------------------------------------------------------------------
# Encrypts the identity-provider client secrets stored in the database: base64 of
# exactly 32 bytes (secret). Generate one with `cloudit-server gen-secret-key`.
# Unset with SQLite: generated on first start into <DATA_DIR>/secret.key (back it up
# together with the database). Required with PostgreSQL: every instance must use the
# same key. If it changes, the server refuses to start ("SECRET_KEY changed or wrong").
# SECRET_KEY=

# Directory for durable data (database, blobs when STORAGE=fs). In Docker: /data.
# DATA_DIR=./data

# ---- Database ----------------------------------------------------------------
# sqlite:<path>?mode=rwc (single instance) or postgres://user:password@host:5432/db
# (required for more than one instance). Unset: SQLite at <DATA_DIR>/cloudit.db.
# Pending migrations run at startup; SQLite is first backed up to
# <DATA_DIR>/backups/cloudit-<timestamp>-pre-migrate.db (never pruned automatically).
# The URL may contain a password: it is never logged.
# DATABASE_URL=postgres://cloudit:change-me@postgres:5432/cloudit

# Connection pool size per instance. Default: 8 for SQLite, 10 for PostgreSQL.
# DB_MAX_CONNECTIONS=

# ---- Blob storage --------------------------------------------------------------
# `fs` (local directory) or `s3` (any S3-compatible service; required for more than
# one instance).
# STORAGE=fs

# STORAGE=fs: directory for blobs. Default: <DATA_DIR>/blobs.
# STORAGE_FS_DIR=

# STORAGE=s3: endpoint as reached by the server; leave unset for AWS S3.
# S3_ENDPOINT=http://garage:3900
# Region the service signs with: AWS region, `garage` for Garage (its s3_region setting).
# S3_REGION=us-east-1
# Required with STORAGE=s3; the bucket must already exist.
# S3_BUCKET=cloudit
# Static credentials (set both, or neither to use the AWS environment/instance role).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Path-style URLs (endpoint/bucket/key). Needed by MinIO and Garage; false for
# virtual-hosted style (bucket.endpoint/key).
# S3_FORCE_PATH_STYLE=true

# Presigned URLs: clients upload/download blobs directly with S3 instead of through
# the server. Only enable it if clients can reach S3 (see S3_PUBLIC_ENDPOINT); leave it
# off when S3 is on a private network and the server proxies.
# S3_PRESIGN=false
# Endpoint as reached by clients, e.g. https://s3.example.com; presigned URLs are signed
# for this host (a proxy in front of it must keep the Host header). Default: S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=
# Validity of presigned URLs: seconds or 30s/15m/1h/1d, at most 7d.
# S3_PRESIGN_TTL=15m

# ---- Redis (optional) ------------------------------------------------------------
# redis://[:password@]host:6379[/db] (Redis or Valkey; TLS rediss:// not supported yet).
# Shared rate limits and real-time events (SSE) across instances (pub/sub channel
# cloudit:events). Never required: if unset or down, the server falls back to
# per-instance limits and events reach only the clients of the instance where the change
# happened (clients then also poll /api/v1/sync/heads), and keeps serving.
# REDIS_URL=redis://valkey:6379

# ---- Background jobs ---------------------------------------------------------------
# Run the maintenance jobs scheduler on this instance (retention every 15 min, gc and
# trash purge and cleanup hourly, orphan sweep daily). Each job runs on one instance at
# a time (database lease), so every instance may keep this on; set false to keep some
# instances request-only.
# JOBS_ENABLED=true
# Age before unreferenced chunks/manifests, and stored objects without a database row
# (e.g. presigned uploads never committed), are deleted: seconds or 30m/1h/1d, at least
# 1h. Keep it well above the longest upload-to-commit time of a client.
# GC_GRACE=24h

# Daily check for a newer cloudit server release (the `update_check` job): admins see a
# notice in the web administration when one is out. `false` never contacts the release server.
# UPDATE_CHECK=true
# Where the releases are listed (a GitHub API "list releases" endpoint, newest first): the
# highest published `server-vX.Y.Z` tag counts; app releases (`app-v…`) are ignored.
# UPDATE_CHECK_URL=https://api.github.com/repos/jacopofilonzi/cloudit/releases?per_page=30

# Directory with the built web UI (apps/web/build), served as an SPA with an
# index.html fallback. If missing, the server logs a warning and serves only the API.
# In Docker: /app/web.
# WEB_DIR=./apps/web/build

# Log verbosity: error, warn, info, debug, trace. RUST_LOG, if set, takes precedence
# and accepts full tracing filter directives (e.g. `info,cloudit_server=debug`).
# LOG_LEVEL=info
# RUST_LOG=

# Log format: `pretty` (human-readable) or `json` (one object per line). Docker: json.
# LOG_FORMAT=pretty

# Docker only (read by the container entrypoint, not by the server): numeric user and
# group the server runs as. The entrypoint starts as root, chowns DATA_DIR to them and
# drops privileges. Set them to your host user (`id -u` / `id -g`) to own ./data yourself.
# PUID=10001
# PGID=10001

# docker-compose.prod.yml only (read by Docker Compose, not by the server): the image
# tag of ghcr.io/jacopofilonzi/cloudit, `latest` (default), `X.Y` or `X.Y.Z`.
# CLOUDIT_VERSION=latest
